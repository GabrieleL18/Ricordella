<?xml version="1.0" encoding="utf-8"?>
<!-- Widget calendario: mese corrente e successivo (sfogliabili), giorni con impegni evidenziati, prossimo promemoria. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_logo_background"
            android:contentDescription="@string/app_name"
            android:padding="3dp"
            android:src="@drawable/ic_widget_bolt" />

        <TextView
            android:id="@+id/widget_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_text_muted"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/widget_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_round_button"
            android:contentDescription="Mese precedente"
            android:padding="6dp"
            android:src="@drawable/ic_widget_chevron_left" />

        <ImageView
            android:id="@+id/widget_next_month"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_round_button"
            android:contentDescription="Mese successivo"
            android:padding="6dp"
            android:src="@drawable/ic_widget_chevron_right" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/widget_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:inAnimation="@anim/widget_page_in"
        android:outAnimation="@anim/widget_page_out" />

    <!-- Anteprima del giorno toccato: compare sotto il mese. -->
    <LinearLayout
        android:id="@+id/widget_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:animateLayoutChanges="true"
        android:background="@drawable/widget_preview_background"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_preview_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_preview_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Chiudi anteprima"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/widget_text_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_preview_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

</LinearLayout>
