<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Carte: le carte fedeltà a blocchi (preferite prime); un tocco su una carta ne mostra il codice. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/cards_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/cards_logo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_logo_background"
            android:contentDescription="@string/app_name"
            android:padding="3dp"
            android:src="@drawable/ic_widget_bolt" />

        <TextView
            android:id="@+id/cards_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Carte"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Dati di esempio per l'anteprima nella scelta dei widget: a runtime si nascondono. -->
    <LinearLayout
        android:id="@+id/cards_sample"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_cyan"
            android:ellipsize="end"
            android:maxLines="1"
            android:padding="10dp"
            android:text="🛒 Coop"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_pear"
            android:ellipsize="end"
            android:maxLines="1"
            android:padding="10dp"
            android:text="🏃 Decathlon"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <GridView
        android:id="@+id/cards_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:horizontalSpacing="6dp"
        android:numColumns="2"
        android:scrollbars="none"
        android:verticalSpacing="6dp" />

    <TextView
        android:id="@+id/cards_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/widget_text_muted"
        android:textSize="13sp" />
</LinearLayout>
