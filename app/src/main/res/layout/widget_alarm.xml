<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Sveglia: la prossima sveglia che suonerà; un tocco la apre, il + ne crea una nuova. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">

    <LinearLayout
        android:id="@+id/alarm_open"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/alarm_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alarm_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/alarm_when"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/alarm_add"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/widget_round_button"
        android:contentDescription="+"
        android:padding="6dp"
        android:src="@drawable/ic_widget_plus" />
</LinearLayout>
