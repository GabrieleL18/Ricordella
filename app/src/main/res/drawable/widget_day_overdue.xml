<?xml version="1.0" encoding="utf-8"?>
<!-- Giorno con promemoria scaduti e non completati: fondo corallo e puntino rosso. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_tone_coral" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:gravity="bottom|center_horizontal" android:width="5dp" android:height="5dp" android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="#FFE53935" />
        </shape>
    </item>
</layer-list>
