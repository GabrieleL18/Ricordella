<?xml version="1.0" encoding="utf-8"?>
<!-- Giorno con almeno un impegno: sfondo lavanda pieno, numero bianco, puntino. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_dot" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:gravity="bottom|center_horizontal" android:width="6dp" android:height="6dp" android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
