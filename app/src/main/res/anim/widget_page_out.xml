<?xml version="1.0" encoding="utf-8"?>
<!-- Il mese che esce: svanisce allargandosi un poco. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_cubic">
    <alpha android:duration="200" android:fromAlpha="1" android:toAlpha="0" />
    <scale android:duration="200" android:fromXScale="1" android:fromYScale="1" android:pivotX="50%" android:pivotY="50%" android:toXScale="1.06" android:toYScale="1.06" />
</set>
