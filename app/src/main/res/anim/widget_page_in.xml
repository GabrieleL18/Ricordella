<?xml version="1.0" encoding="utf-8"?>
<!-- Il mese che entra: compare ingrandendosi leggermente. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <alpha android:duration="320" android:fromAlpha="0" android:toAlpha="1" />
    <scale android:duration="320" android:fromXScale="0.9" android:fromYScale="0.9" android:pivotX="50%" android:pivotY="50%" android:toXScale="1" android:toYScale="1" />
</set>
